{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "pwsh -NoProfile -File scripts/hooks/log-interaction.ps1 sessionStart",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hooks/log-interaction.ps1 sessionStart",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "pwsh -NoProfile -File scripts/hooks/log-interaction.ps1 userPromptSubmitted",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hooks/log-interaction.ps1 userPromptSubmitted",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "pwsh -NoProfile -File scripts/hooks/log-interaction.ps1 postToolUse",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hooks/log-interaction.ps1 postToolUse",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "pwsh -NoProfile -File scripts/hooks/log-interaction.ps1 subagentStop",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hooks/log-interaction.ps1 subagentStop",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "pwsh -NoProfile -File scripts/hooks/log-interaction.ps1 sessionEnd",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hooks/log-interaction.ps1 sessionEnd",
        "timeoutSec": 10
      }
    ]
  }
}
